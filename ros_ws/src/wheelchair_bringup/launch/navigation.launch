<?xml version="1.0"?>
<!--
  navigation.launch
  Brings up the move_base navigation stack, loading global/local costmap
  parameters and planner configuration from wheelchair_navigation/config.

  Assumes hardware.launch (or equivalent) is already running to provide
  /scan, /odom, and the odom -> base_link tf.
-->
<launch>
  <arg name="map_file" default="$(find wheelchair_navigation)/maps/map.yaml" />
  <arg name="use_map_server" default="true" />

  <!-- ===================== Static map server ===================== -->
  <node if="$(arg use_map_server)" name="map_server" pkg="map_server" type="map_server"
        args="$(arg map_file)" />

  <!-- ===================== AMCL localization ===================== -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="odom_model_type"     value="diff" />
    <param name="odom_frame_id"       value="odom" />
    <param name="base_frame_id"       value="base_link" />
    <param name="global_frame_id"     value="map" />
    <param name="initial_pose_x"      value="0.0" />
    <param name="initial_pose_y"      value="0.0" />
    <param name="initial_pose_a"      value="0.0" />
    <param name="min_particles"       value="200" />
    <param name="max_particles"       value="2000" />
  </node>

  <!-- ===================== move_base ===================== -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find wheelchair_navigation)/config/costmap_common.yaml"
              command="load" ns="global_costmap" />
    <rosparam file="$(find wheelchair_navigation)/config/costmap_common.yaml"
              command="load" ns="local_costmap" />
    <rosparam file="$(find wheelchair_navigation)/config/costmap_global.yaml"
              command="load" ns="global_costmap" />
    <rosparam file="$(find wheelchair_navigation)/config/costmap_local.yaml"
              command="load" ns="local_costmap" />
    <rosparam file="$(find wheelchair_navigation)/config/move_base.yaml"
              command="load" />

    <!-- Global planner: A* via global_planner/GlobalPlanner (use_dijkstra=false,
         use_grid_path=true; see move_base.yaml for the full param set). -->
    <param name="base_global_planner" value="global_planner/GlobalPlanner" />

    <!-- Local planner: DWA -->
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS" />
  </node>
</launch>

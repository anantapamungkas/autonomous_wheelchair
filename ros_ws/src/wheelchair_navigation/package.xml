<?xml version="1.0"?>
<package format="2">
  <name>wheelchair_navigation</name>
  <version>1.0.0</version>
  <description>move_base configuration: A* global planner, DWA local planner, costmaps tuned for RPLidar A2M8.</description>
  <maintainer email="robotics@example.com">Robotics Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>move_base</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>costmap_2d</exec_depend>
  <exec_depend>amcl</exec_depend>
  <exec_depend>map_server</exec_depend>
</package>
